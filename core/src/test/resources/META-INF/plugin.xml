<idea-plugin>
    <id>com.github.artemkacreate.optimusplugin.core.test</id>
    <name>Optimus Accessibility Core Tests</name>

    <depends>com.intellij.modules.xml</depends>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
                shortName="GlobalAccessibilityInspection"
                displayName="Optimus Accessibility: Check a11y rules"
                groupName="Accessibility"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.github.artemkacreate.optimusplugin.inspections.GlobalAccessibilityInspection"
                language=""/>
    </extensions>
</idea-plugin>
