<idea-plugin>
    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.artemkacreate.optimusplugin.toolWindow.MyToolWindowFactory" id="MyToolWindow" anchor="right"/>
        <postStartupActivity implementation="com.github.artemkacreate.optimusplugin.startup.MyProjectActivity" />
        <localInspection
                shortName="GlobalAccessibilityInspection"
                displayName="Optimus Accessibility: Check a11y rules"
                groupName="Accessibility"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.github.artemkacreate.optimusplugin.inspections.GlobalAccessibilityInspection"
                language=""/>
    </extensions>
</idea-plugin>
