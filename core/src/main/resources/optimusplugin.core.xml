<idea-plugin>
    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="com.github.artemkacreate.optimusplugin.toolWindow.MyToolWindowFactory"
                    id="MyToolWindow" anchor="right"/>
        <postStartupActivity implementation="com.github.artemkacreate.optimusplugin.startup.MyProjectActivity"/>
        <localInspection
                shortName="GlobalAccessibilityInspection"
                displayName="Optimus Accessibility: Check a11y rules"
                groupName="Accessibility"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.github.artemkacreate.optimusplugin.inspections.GlobalAccessibilityInspection"
                language=""/>
        <applicationConfigurable
                parentId="tools"
                instance="com.github.artemkacreate.optimusplugin.options.RuleSettingsConfigurable"
                id="com.github.artemkacreate.optimusplugin.settings"
                displayName="Optimus Accessibility"/>
    </extensions>
</idea-plugin>
